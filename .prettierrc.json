{
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": "mobile/**",
      "options": { "printWidth": 100, "trailingComma": "all", "arrowParens": "always" }
    },
    {
      "files": "workers/**",
      "options": { "printWidth": 100, "arrowParens": "always" }
    }
  ]
}
