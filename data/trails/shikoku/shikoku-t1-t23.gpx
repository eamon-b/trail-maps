    <name>Toyoko Inn Tokushima Ekimae</name>
    <type>accommodation</type>
    <desc>Chain business hotel 東横INN徳島駅前 by Tokushima Station. Breakfast included. Check-in 15:00, check-out 10:00. Cards accepted. https://www.toyoko-inn.com/search/detail/00192/</desc>
  </wpt>
