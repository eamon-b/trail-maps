{
  "expo": {
    "name": "MapLibre Offline Spike",
    "slug": "MapLibreSpike",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trailmaps.maplibre.spike",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show your position on the trail map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.trailmaps.maplibre.spike",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "@maplibre/maplibre-react-native",
        {
          "locationWhenInUsePermission": "Show current location on the map."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa2276df-edf1-4fae-a23b-d4bf7828fbb1"
      }
    },
    "owner": "eamonb123"
  }
}
