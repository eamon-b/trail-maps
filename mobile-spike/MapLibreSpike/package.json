{
  "name": "maplibre-spike",
  "version": "1.0.0",
  "description": "Technical spike to validate MapLibre offline tile caching for React Native",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:dev:ios": "npx eas-cli build --profile development --platform ios",
    "build:dev:android": "npx eas-cli build --profile development --platform android",
    "build:dev": "npx eas-cli build --profile development --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "check": "npm run typecheck && npm run lint",
    "doctor": "npx expo-doctor",
    "export": "expo export"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@turf/turf": "^7.3.3",
    "expo": "~54.0.33",
    "expo-dev-client": "^6.0.20",
    "expo-file-system": "^19.0.21",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
