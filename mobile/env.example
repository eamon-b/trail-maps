# Local development environment for the mobile app.
# Copy to .env (gitignored) and fill in real values:  cp env.example .env
# EAS builds get these from eas.json build profiles instead — keep both in sync.

# R2 public bucket serving offline tile downloads (trail + grid mbtiles).
EXPO_PUBLIC_TILE_BASE_URL=https://pub-2c4c91b48919451cb92108f6171071d6.r2.dev

# Contour tile worker (workers/contour-tiles). Serves /contours/{z}/{x}/{y}.pbf
# from the Australia-wide PMTiles on R2. This is the *worker* URL
# (https://contour-tiles.<account-subdomain>.workers.dev), NOT the R2 bucket.
# Without it, online maps show no contours (online-style-service returns null).
EXPO_PUBLIC_CONTOUR_TILE_URL=
