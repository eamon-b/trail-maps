{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@lib/*": ["../src/lib/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/lib/**/*.test.ts"
  ]
}
