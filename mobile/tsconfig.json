{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 dropped the implicit "every package under node_modules/@types
    // is a global" rule, so the global-only type packages have to be named.
    // Everything else (@types/react, @types/better-sqlite3, ...) still resolves
    // through ordinary module resolution and must NOT be listed here.
    "types": ["jest", "node", "geojson"],
    "paths": {
      "@/*": ["./*"],
      "@lib/*": ["../src/lib/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/lib/**/*.test.ts"
  ]
}
