{
  "name": "trail-maps",
  "version": "1.0.0",
  "description": "Interactive trail maps for Australian long-distance hiking trails",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "npm run check:web && npm run check:mobile",
    "check:web": "npm test && npm run lint",
    "check:mobile": "npm --prefix mobile test -- --runInBand && npm --prefix mobile run typecheck && npm --prefix mobile run lint",
    "phone": "npm --prefix mobile start",
    "phone:android:usb": "adb reverse tcp:8081 tcp:8081 && npm --prefix mobile start -- --localhost",
    "build": "npm run fetch:climate && npm run build:trails && tsc && vite build",
    "build:trails": "tsx scripts/build-trails.ts",
    "fetch:climate": "tsx scripts/fetch-climate.ts",
    "fetch:elevation": "tsx scripts/fetch-elevation.ts",
    "build:tiles": "tsx scripts/build-tiles.ts",
    "build:tiles:bibbulmun": "tsx scripts/build-tiles.ts --trail bibbulmun",
    "build:contours-australia": "tsx scripts/build-contours-australia.ts",
    "experiment:contours": "tsx scripts/contour-experiment.ts",
    "sync:style": "cp scripts/topo-style.json mobile/assets/topo-style.json && cp scripts/topo-style-dark.json mobile/assets/topo-style-dark.json",
    "fetch:fonts": "tsx scripts/fetch-font-glyphs.ts",
    "upload:tiles": "bash scripts/upload-tiles.sh",
    "upload:descriptions": "tsx scripts/upload-descriptions.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "build:mobile-trails": "tsx scripts/build-mobile-trails.ts"
  },
  "dependencies": {
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.10.0",
    "@types/papaparse": "^5.3.14",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.11.0",
    "jsdom": "^27.4.0",
    "marked": "^18.0.10",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
