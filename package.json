{
  "name": "tracknotes",
  "version": "1.0.0",
  "description": "Tracknotes: maps, waypoints and trip planning for long-distance hiking trails",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "check": "npm run check:web && npm run check:mobile",
    "check:web": "npm test && npm run lint",
    "check:mobile": "npm --prefix mobile test -- --runInBand && npm --prefix mobile run typecheck && npm --prefix mobile run lint",
    "phone": "npm --prefix mobile start",
    "phone:android:usb": "adb reverse tcp:8081 tcp:8081 && npm --prefix mobile start -- --localhost",
    "build": "npm run sync:te-araroa && npm run fetch:climate && npm run build:trails && tsc && vite build",
    "build:trails": "tsx scripts/build-trails.ts",
    "sync:te-araroa": "tsx scripts/sync-te-araroa.ts",
    "fetch:climate": "tsx scripts/fetch-climate.ts",
    "fetch:elevation": "tsx scripts/fetch-elevation.ts",
    "fetch:pois": "tsx scripts/fetch-pois.ts",
    "fetch:access": "tsx scripts/fetch-access.ts",
    "build:tiles": "tsx scripts/build-tiles.ts",
    "build:tiles:bibbulmun": "tsx scripts/build-tiles.ts --trail bibbulmun",
    "experiment:contours": "tsx contours/scripts/contour-experiment.ts",
    "sync:style": "cp scripts/topo-style.json mobile/assets/topo-style.json && cp scripts/topo-style-dark.json mobile/assets/topo-style-dark.json",
    "fetch:fonts": "tsx scripts/fetch-font-glyphs.ts",
    "upload:tiles": "bash scripts/upload-tiles.sh",
    "cleanup:tiles": "tsx scripts/cleanup-superseded-tiles.ts",
    "check:tile-packs": "node scripts/e2e-tile-check.mjs --packs --tiered",
    "check:tiered": "node scripts/e2e-tile-check.mjs --tiered",
    "check:contours-alias": "node scripts/e2e-tile-check.mjs --alias",
    "upload:descriptions": "tsx scripts/upload-descriptions.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts contours/scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:mobile-trails": "tsx scripts/build-mobile-trails.ts",
    "publish:trail-data": "tsx scripts/publish-trail-data.ts",
    "build:region-shapes": "tsx scripts/build-region-shapes.ts",
    "trace:mark-contours": "tsx scripts/trace-mark-contours.ts"
  },
  "dependencies": {
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-contour": "^3.0.6",
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.3.14",
    "d3-contour": "^4.0.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.11.0",
    "geotiff": "^3.0.5",
    "globals": "^14.0.0",
    "gpx-tools": "github:eamon-b/gpx-tools#main",
    "jsdom": "^27.4.0",
    "marked": "^18.0.10",
    "prettier": "3.9.10",
    "te-araroa-data": "github:eamon-b/te-araroa-data#main",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.149.0"
  }
}
