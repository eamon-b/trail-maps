{
  "name": "trail-maps",
  "version": "1.0.0",
  "description": "Interactive trail maps for Australian long-distance hiking trails",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run fetch:climate && npm run build:trails && tsc && vite build",
    "build:trails": "tsx scripts/build-trails.ts",
    "fetch:climate": "tsx scripts/fetch-climate.ts",
    "fetch:elevation": "tsx scripts/fetch-elevation.ts",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.10.0",
    "@types/papaparse": "^5.3.14",
    "eslint": "^8.55.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.6",
    "vitest": "^1.0.4"
  }
}
