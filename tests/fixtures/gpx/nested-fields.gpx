<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="test" xmlns="http://www.topografix.com/GPX/1/1">
  <!-- Every field below is nested inside another element that has a field of
       the same name first, which a descendant search finds instead. -->
  <metadata>
    <author><name>Jane Mapper</name></author>
    <name>Nested Fields Trail</name>
  </metadata>
  <wpt lat="-33.8700" lon="151.2100">
    <link href="https://example.com/hut"><text>Hut page</text><type>text/html</type></link>
    <name>Ridge Hut</name>
    <type>hut</type>
  </wpt>
  <wpt lat="-33.8750" lon="151.2150">
    <link href="https://example.com/tank"><type>text/html</type></link>
    <name>Tank With No Type</name>
  </wpt>
  <trk>
    <trkseg>
      <trkpt lat="-33.8688" lon="151.2093">
        <name>First point</name>
        <extensions><ele>9999</ele><time>1999-01-01T00:00:00Z</time></extensions>
        <ele>10</ele>
      </trkpt>
      <trkpt lat="-33.8700" lon="151.2100"><ele>15</ele></trkpt>
      <trkpt lat="-33.8750" lon="151.2150"><ele>20</ele></trkpt>
    </trkseg>
  </trk>
</gpx>
